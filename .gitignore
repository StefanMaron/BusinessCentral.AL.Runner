# .NET build output
bin/
obj/

# Spike v2 runner — repo-root v2-classification.json is the runtime output of
# `dotnet run --project spike/v2/Runner` and is regenerated on every run.
# The committed snapshot lives at spike/v2/Runner/v2-classification.json.
/v2-classification.json
# Also ignore per-bucket classification artifacts written when running against tests/bucket-*/.
tests/**/v2-classification.json

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# OS files
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx
*.coverage

# dotnet tools
.config/

# BC artifacts (large, machine-specific)
artifacts/
*.app

# Coverage reports
cobertura.xml
lcov.info

# Logs
*.log

.mcp.json

# Benchmark artifacts
BenchmarkDotNet.Artifacts/
publish-*/
**/__pycache__/

# Symbol probe tool (dev-only)
SymbolProbe/

# Claude Code — local-only state (worktrees, per-user settings, lock files)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
tests/.claude/

# Experimental DotNet-interop probe suite — never committed (OnPrem/Windows-only,
