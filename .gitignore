# .NET build output
bin/
obj/

# Spike v2 runner — repo-root v2-classification.json is the runtime output of
# `dotnet run --project spike/v2/Runner` and is regenerated on every run.
# The committed snapshot lives at spike/v2/Runner/v2-classification.json.
/v2-classification.json
# Also ignore per-bucket classification artifacts written when running against tests/bucket-*/.
tests/**/v2-classification.json

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json

# OS files
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx
*.coverage

# dotnet tools
.config/

# BC artifacts (large, machine-specific)
artifacts/
*.app

# Coverage reports
cobertura.xml
lcov.info

# Logs
*.log

.mcp.json

# Benchmark artifacts
BenchmarkDotNet.Artifacts/
publish-*/
**/__pycache__/

# Symbol probe tool (dev-only)
SymbolProbe/

# Claude Code — local-only state (worktrees, per-user settings, lock files)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
tests/.claude/

# Experimental DotNet-interop probe suite — never committed (OnPrem/Windows-only,
# permanently red on Linux). See project_dotnet_sspw_resolution_hard memory.
tests/runner-extras/dotnet-interop/
.serena/

# #1672: prebuilt Win32 stub shims are build artifacts, produced fresh per-arch by
# AlRunner.csproj's BuildWin32PrebuiltStubs target — never committed as binaries.
AlRunner/Win32Stubs/*.so

# #1881: BuildDeterminismTests (AlRunner.Tests) generates a throwaway probe project
# directly under the repo root (so it inherits Directory.Build.props via MSBuild's
# normal upward search) and deletes it in a `finally`. A hard crash/kill/timeout can
# leave one behind — ignore it so a stray copy never shows up as untracked or gets
# swept into a `git add -A`.
/.build-determinism-probe-*/

# The DOTNET_STARTUP_HOOKS runsettings for the in-process BC engine tests is GENERATED,
# never authored: test-matrix.yml writes it fresh per leg (see its "Generate .runsettings"
# step) and anyone running the suite locally writes their own. It embeds ABSOLUTE paths to
# AlRunner.Tests' bin dir, so a committed copy would be wrong on every machine but the one
# that produced it — and CI would silently overwrite it anyway. Same rationale as #1881
# above: keep a stray copy from showing up as untracked or being swept into `git add -A`.
/engine.runsettings
